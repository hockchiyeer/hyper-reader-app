{
  "name": "hyper-reader-app",
  "version": "1.0.0",
  "private": true,
  "description": "Static HyperReader workspace for open-link reading, diagnosis, trails, and source management.",
  "scripts": {
    "test:e2e": "node scripts/run-cypress.cjs run",
    "test:e2e:headed": "node scripts/run-cypress.cjs run --headed",
    "cypress:open": "node scripts/run-cypress.cjs open"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "24.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "2.2.8",
    "cypress": "15.14.2",
    "esbuild": "0.28.0"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/step_definitions/**/*.{js,ts}"
    ]
  }
}
